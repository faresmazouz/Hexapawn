<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:ModelHexa;assembly=ModelHexa"
    x:Class="Hexapawn.Scores"
    BackgroundColor="#F0F0F0"
    Title="Scores">

    <ScrollView>
        <Grid Padding="20" BindingContext="{Binding Mgr}">
            <Border StrokeThickness="0"
                    BackgroundColor="#5A4745"
                    StrokeShape="RoundRectangle"
                    Padding="20">
                <VerticalStackLayout Spacing="30" HorizontalOptions="Center">

                    <!-- Total games played -->
                    <VerticalStackLayout Spacing="10" BindingContext="{Binding PartiesTotales}">
                        <Label Text="Nombre de parties totales jouées contre un BOT :" 
                               TextColor="White" FontSize="24" FontFamily="OpenSansBold" 
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding Value}"
                               TextColor="White" FontSize="18" FontFamily="OpenSansBold"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Bot games -->
                    <VerticalStackLayout Spacing="10" BindingContext="{Binding PartiesVsBot}">
                        <Label Text="Nombre de parties jouées par le BOT :"
                               TextColor="White" FontSize="24" FontFamily="OpenSansBold"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding Value}"
                               TextColor="White" FontSize="18" FontFamily="OpenSansBold"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Victoires / Défaites globales -->
                    
                        <VerticalStackLayout Spacing="10" Grid.Column="0" BindingContext="{Binding Victoires}">
                            <Label Text="Victoires :" 
                                   TextColor="White" FontSize="22" FontFamily="OpenSansBold"/>
                            <Label Text="{Binding Value}" 
                                   TextColor="White" FontSize="20" FontFamily="OpenSansBold"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10" Grid.Column="1" BindingContext="{Binding Defaites}">
                            <Label Text="Défaites :" 
                                   TextColor="White" FontSize="22" FontFamily="OpenSansBold"/>
                            <Label Text="{Binding Value}" 
                                   TextColor="White" FontSize="20" FontFamily="OpenSansBold"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    

                    <!-- Victoires / Défaites vs Bot actuel -->
                    
                        <VerticalStackLayout Spacing="10" Grid.Column="0" BindingContext="{Binding VictoiresVsBot}">
                            <Label Text="Victoires vs Bot actuel :" 
                                   TextColor="White" FontSize="18" FontFamily="OpenSansBold"/>
                            <Label Text="{Binding Value}" 
                                   TextColor="White" FontSize="16" FontFamily="OpenSansBold"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10" Grid.Column="1" BindingContext="{Binding DefaitesVsBot}">
                        <Label Text="Défaites vs Bot actuel :" 
                                   TextColor="White" FontSize="18" FontFamily="OpenSansBold"/>
                            <Label Text="{Binding Value}" 
                                   TextColor="White" FontSize="16" FontFamily="OpenSansBold"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    

                    <!-- Reset button -->
                    <Button Text="Afficher le tableau des scores"
                            BackgroundColor="#F9EAEA"
                            TextColor="Black"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="15"
                            HeightRequest="50"
                            WidthRequest="300"
                            HorizontalOptions="Center"/>

                    <!-- Back button -->
                    <ImageButton Source="back_icon.png"
                                 BackgroundColor="White"
                                 HeightRequest="44"
                                 WidthRequest="44"
                                 CornerRadius="12"
                                 HorizontalOptions="Start"/>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
