    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Hexapawn"
    Shell.FlyoutBehavior="Flyout"
    Title="solution">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Scores"
        ContentTemplate="{DataTemplate local:Scores}"
        Route="Scores" />
    <ShellContent
        Title="Themes"
        ContentTemplate="{DataTemplate local:ThemePage}"
        Route="ThemePage" />
    <ShellContent
        Title="Règles"
        ContentTemplate="{DataTemplate local:RulesPage}"
        Route="RulesPage" />


</Shell>
