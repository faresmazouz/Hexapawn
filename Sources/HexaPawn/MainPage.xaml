<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="solution.MainPage"
             xmlns:local="clr-namespace:solution"
             BackgroundColor="#3E3232">

    <Grid Padding="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        
        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
            <Button Text="Apparence" Style="{StaticResource MenuButtonStyle}" Clicked="OnClickedApparence"/>
            <Label x:Name="texteMode" Text="mode de jeu" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" IsVisible="True"/>
            <Button x:Name="cl"  Text="Classique" Style="{StaticResource MenuButtonStyle}"  Clicked="OnClickedClassic" IsVisible="True"/>
            <Button x:Name="qxq"  Text="4x4" Style="{StaticResource MenuButtonStyle}"  Clicked="OnClicked4x4" IsVisible="True"/>
            <Button x:Name="cxc"  Text="5x5" Style="{StaticResource MenuButtonStyle}" Clicked="OnClicked5x5" IsVisible="True"/>
        </VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Plateau.FlatBoard}"
                BackgroundColor="Azure"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                        Grid.Column="1">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                            Span="{Binding Plateau.Length}"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border WidthRequest="50" HeightRequest="50"
                    BackgroundColor="#3E3232"
                    Margin="4">
                        <Label Text="{Binding Pawn}"
                        TextColor="Black"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CellTappedCommand}"
        CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
