        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
            <Button x:Name="GiveUp"
        Text="{Binding textGiveUpButton}"
        Style="{StaticResource MenuButtonStyle}" 
        Clicked="OnClickedGiveUp"
        WidthRequest="200"
        IsVisible="False"/>
            <Button x:Name="Scores"
                    Text="Scores"  
                    Style="{StaticResource MenuButtonStyle}" 
                    WidthRequest="200"
                    Clicked="OnClickedScores"
                    IsVisible="True"/>

        </VerticalStackLayout>

       
        <Label Text="HEXAPAWN" Grid.ColumnSpan="3"
               FontFamily="Consolas"
               FontSize="40"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,10,0,0"
               />

       
        <HorizontalStackLayout Grid.Column="1" VerticalOptions="End" HorizontalOptions="Center" Spacing="20" Margin="0,0,0,20">
            <Button x:Name="uvu"
                    Clicked="OnClicked1v1"
                    Text="2 JOUEURS" 
                    Style="{StaticResource MenuButtonStyle}" 
                    WidthRequest="150"
                    IsVisible="True"/>
            
            <Button x:Name="Bvu"
                    Text="Joueur VS BOT" 
                    Clicked="OnClickedBv1"
                    Style="{StaticResource MenuButtonStyle}" 
                    WidthRequest="150"
                    IsVisible="True"/>
            <Button x:Name="BvB"
                Text="BOT VS BOT" 
                    Clicked="OnClickedBvB"
                Style="{StaticResource MenuButtonStyle}" 
                WidthRequest="150"
                IsVisible="True"/>
            <Label x:Name="Bndeau" Text="{Binding Bandeau}" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" IsVisible="False"/>

        </HorizontalStackLayout>
    </Grid>
</ContentPage>

