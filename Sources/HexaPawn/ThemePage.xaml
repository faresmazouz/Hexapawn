<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="solution.ThemePage"
    BackgroundColor="#5C4B4B"
    Padding="20">

    <ScrollView>
        <VerticalStackLayout Spacing="30">

            
            <Border Stroke="Black"
                    StrokeThickness="3"
                    BackgroundColor="#D9D9D9"
                    StrokeShape="RoundRectangle 20"
                    Padding="10"
                    HorizontalOptions="Center">
                <Label Text="THEME"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1"/>
            </Border>

            
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="30" RowSpacing="30">

                
                <VerticalStackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" Spacing="10">
                    <Label Text="Normal" TextColor="WhiteSmoke" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center"/>
                    <Border Stroke="Black"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="Transparent">
                        <ImageButton Source="normal_theme.png"
                                     WidthRequest="150"
                                     HeightRequest="150"
                                     BackgroundColor="Transparent"
                                     Clicked="OnThemeSelected"
                                     CommandParameter="Normal"/>
                    </Border>
                </VerticalStackLayout>

                
                <VerticalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" Spacing="10">
                    <Label Text="HexaChaos" TextColor="WhiteSmoke" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center"/>
                    <Border Stroke="Black"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="Transparent">
                        <ImageButton Source="hexachaos_theme.png"
                                     WidthRequest="150"
                                     HeightRequest="150"
                                     BackgroundColor="Transparent"
                                     Clicked="OnThemeSelected"
                                     CommandParameter="HexaChaos"/>
                    </Border>
                </VerticalStackLayout>

                
                <VerticalStackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" Spacing="10">
                    <Label Text="Original" TextColor="WhiteSmoke" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center"/>
                    <Border Stroke="Black"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="Transparent">
                        <ImageButton Source="original_theme.png"
                                     WidthRequest="150"
                                     HeightRequest="150"
                                     BackgroundColor="Transparent"
                                     Clicked="OnThemeSelected"
                                     CommandParameter="Original"/>
                    </Border>
                </VerticalStackLayout>

                
                <VerticalStackLayout Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" Spacing="10">
                    <Label Text="Python" TextColor="WhiteSmoke" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center"/>
                    <Border Stroke="Black"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="Transparent">
                        <ImageButton Source="python_theme.png"
                                     WidthRequest="150"
                                     HeightRequest="150"
                                     BackgroundColor="Transparent"
                                     Clicked="OnThemeSelected"
                                     CommandParameter="Python"/>
                    </Border>
                </VerticalStackLayout>

            </Grid>

            
            <Border Stroke="Black"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 30"
                    BackgroundColor="White"
                    WidthRequest="70"
                    HeightRequest="70"
                    HorizontalOptions="Start">
                <ImageButton Source="back_arrow.png"
                             BackgroundColor="Transparent"
                             Clicked="OnBackClicked"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
